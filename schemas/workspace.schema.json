{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mberlanda/quantik-workspace/schemas/workspace.schema.json",
  "title": "Quantik workspace manifest",
  "type": "object",
  "required": ["version", "workspace", "repositories", "dependencies"],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "workspace": {
      "type": "object",
      "required": ["name", "repository_layout"],
      "properties": {
        "name": {"type": "string"},
        "repository_layout": {"type": "string", "enum": ["siblings"]},
        "context_budget_tokens": {"type": "integer"}
      }
    },
    "repositories": {"type": "object"},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "types"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "types": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
