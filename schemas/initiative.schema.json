{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mberlanda/quantik-workspace/schemas/initiative.schema.json",
  "type": "object",
  "required": ["id", "title", "status", "problem", "affected_repositories", "acceptance_criteria"],
  "properties": {
    "id": {"type": "string", "pattern": "^QW-[0-9]{3}$"},
    "title": {"type": "string"},
    "status": {"type": "string", "enum": ["planned", "active", "blocked", "completed", "archived"]},
    "problem": {"type": "string"},
    "affected_repositories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "affected_contracts": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
