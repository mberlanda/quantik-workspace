{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mberlanda/quantik-workspace/schemas/repo-task.schema.json",
  "type": "object",
  "required": ["repository", "objective", "inputs", "outputs", "tests", "completion_criteria"],
  "properties": {
    "repository": {"type": "string"},
    "objective": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "required_contract_release": {"type": ["string", "null"]},
    "wire_contracts": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
