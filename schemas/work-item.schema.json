{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "repository",
    "packet",
    "branch",
    "allowed_paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*$"
    },
    "repository": {
      "type": "string"
    },
    "packet": {
      "type": "string",
      "pattern": "^repos/[^/]+/[^/]+\\.md$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "complexity": {
      "type": "string",
      "enum": ["S", "M", "L", "XL"],
      "description": "Engineering complexity of this work item. See tasks/dispatch-sizing.md."
    },
    "dispatch": {
      "type": "string",
      "enum": ["mechanical", "execute-and-record", "judgment"],
      "description": "What kind of agent this item wants. mechanical: every decision is already made. execute-and-record: run the specified thing and report real output. judgment: a real call to make, so a capable model plus human review."
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
